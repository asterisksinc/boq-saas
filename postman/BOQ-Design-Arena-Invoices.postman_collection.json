{
  "info": {
    "name": "BOQ Design Arena — Invoices",
    "description": "Internal User invoice API workflow. Authenticate first with an Auth collection and keep Postman's cookie jar enabled. Apply migrations through 20260901150000_invoices.sql.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "invoiceId", "value": "" },
    { "key": "projectId", "value": "22222222-2222-4222-8222-222222222222" },
    { "key": "clientId", "value": "33333333-3333-4333-8333-333333333333" }
  ],
  "item": [
    {
      "name": "01 — Create and Read",
      "item": [
        {
          "name": "Create Draft Invoice",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"type\": \"invoice\",\n  \"clientId\": \"{{clientId}}\",\n  \"clientName\": \"Kohinoor Group\",\n  \"billingAddress\": {\n    \"line1\": \"42 Main Road\",\n    \"line2\": null,\n    \"city\": \"Mumbai\",\n    \"state\": \"Maharashtra\",\n    \"pincode\": \"400052\"\n  },\n  \"projectId\": \"{{projectId}}\",\n  \"projectName\": \"Kohinoor Office - L4\",\n  \"issueDate\": \"2026-09-01\",\n  \"dueDate\": \"2026-09-15\",\n  \"milestone\": \"Design Stage - 30%\",\n  \"reference\": \"PO-2026-091\",\n  \"taxRate\": 18,\n  \"additionalNotes\": \"Payment due within 14 days.\",\n  \"status\": \"draft\",\n  \"items\": [\n    { \"description\": \"Interior Design Services - Stage 2\", \"quantity\": 1, \"rate\": 220000 },\n    { \"description\": \"Project Management\", \"quantity\": 1, \"rate\": 40000 }\n  ]\n}" },
            "url": "{{baseUrl}}/api/v1/invoices"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Created', () => pm.response.to.have.status(201));", "const body = pm.response.json();", "if (body.data && body.data.id) pm.collectionVariables.set('invoiceId', body.data.id);", "pm.test('Server calculated total', () => pm.expect(body.data.totalAmount).to.eql(306800));"] } }]
        },
        { "name": "Invoice Summary", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/invoices/summary" } },
        {
          "name": "List Invoices",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/invoices?page=1&pageSize=10&search=Kohinoor" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Page returned', () => pm.response.to.have.status(200));", "pm.test('Items array', () => pm.expect(pm.response.json().data.items).to.be.an('array'));"] } }]
        },
        { "name": "Get Invoice Preview", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/invoices/{{invoiceId}}" } },
        { "name": "Download Invoice PDF", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/invoices/{{invoiceId}}/pdf" } }
      ]
    },
    {
      "name": "02 — Edit and Lifecycle",
      "item": [
        {
          "name": "Edit Invoice Notes",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"additionalNotes\": \"Updated payment instructions.\" }" }, "url": "{{baseUrl}}/api/v1/invoices/{{invoiceId}}" }
        },
        {
          "name": "Send to Client — Record Sent State",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"status\": \"sent\" }" }, "url": "{{baseUrl}}/api/v1/invoices/{{invoiceId}}/status" }
        },
        {
          "name": "Record Partial Payment",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"amount\": 100000,\n  \"paidAt\": \"2026-09-01T10:00:00+05:30\",\n  \"method\": \"bank_transfer\",\n  \"reference\": \"UTR123456\",\n  \"notes\": \"First installment\"\n}" }, "url": "{{baseUrl}}/api/v1/invoices/{{invoiceId}}/payments" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Payment recorded', () => pm.response.to.have.status(201));", "pm.test('Partial state', () => pm.expect(pm.response.json().data.storedStatus).to.eql('partial'));"] } }]
        }
      ]
    },
    {
      "name": "03 — Negative and Authorization Checks",
      "item": [
        {
          "name": "Reject Client-Supplied Totals",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"type\": \"invoice\", \"clientName\": \"Client\", \"billingAddress\": { \"line1\": \"A\", \"city\": \"B\", \"state\": \"C\", \"pincode\": \"123456\" }, \"projectName\": \"P\", \"issueDate\": \"2026-09-01\", \"dueDate\": \"2026-09-02\", \"milestone\": \"M\", \"items\": [{ \"description\": \"X\", \"quantity\": 1, \"rate\": 1 }], \"totalAmount\": 1 }" }, "url": "{{baseUrl}}/api/v1/invoices" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Mass assignment rejected', () => pm.response.to.have.status(400));"] } }]
        },
        {
          "name": "Reject Overpayment",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"amount\": 999999999, \"method\": \"cash\" }" }, "url": "{{baseUrl}}/api/v1/invoices/{{invoiceId}}/payments" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Overpayment rejected', () => pm.response.to.have.status(400));"] } }]
        },
        {
          "name": "Reject Archive After Payment — Owner/Admin",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/invoices/{{invoiceId}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Paid history preserved', () => pm.response.to.have.status(409));"] } }]
        }
      ]
    }
  ]
}
