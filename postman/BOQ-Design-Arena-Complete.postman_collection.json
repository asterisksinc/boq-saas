  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "let json;",
          "try { json = pm.response.json(); } catch (_) {}",
          "const requestId = json?.requestId || json?.error?.requestId || pm.response.headers.get('x-request-id');",
          "if (requestId) pm.environment.set('lastRequestId', requestId);",
          "pm.test('Response never exposes a stack trace', function () {",
          "  pm.expect(pm.response.text().toLowerCase()).not.to.include('stack trace');",
          "});"
        ]
      }
    }
