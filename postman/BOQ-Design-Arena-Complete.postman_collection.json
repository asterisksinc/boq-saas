    {
      "name": "06 — Proposals",
      "item": [
        {
          "name": "Create Proposal — From Scratch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"projectName\": \"Oberoi Residence - Bandra\",\n  \"clientName\": \"Nikhil Oberoi\",\n  \"sourceType\": \"scratch\",\n  \"proposedValue\": 5820000,\n  \"expiryDate\": \"2026-09-30\",\n  \"internalNotes\": \"Created from the proposal modal\",\n  \"scopeItems\": [\"Interior design and space planning\", \"Furniture procurement and installation\"]\n}"
            },
            "url": "{{baseUrl}}/api/v1/proposals"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created', () => pm.response.to.have.status(201));",
