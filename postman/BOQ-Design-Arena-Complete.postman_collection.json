    {
      "name": "05 — Negative Security Checks",
      "description": "These requests should fail and demonstrate mass-assignment and authentication protection.",
      "item": [
        {
          "name": "Reject User Mass Assignment",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Attacker\",\n  \"role\": \"owner\",\n  \"workspaceId\": \"00000000-0000-0000-0000-000000000000\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/users/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Mass assignment rejected', () => pm.response.to.have.status(400));",
                  "pm.test('Validation error returned', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unauthenticated Dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "",
                "disabled": true
              }
            ],
            "url": "{{baseUrl}}/api/v1/dashboard/overview",
            "description": "Clear cookies for baseUrl in Postman's Cookies manager before running. Expected status: 401."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Authentication required', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid Credentials",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"definitely-wrong-password\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Generic authentication failure', () => pm.response.to.have.status(401));",
                  "pm.test('No credential detail leaked', () => pm.expect(pm.response.json().error.message).to.eql('Invalid email or password.'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unauthenticated Auth Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/me",
            "description": "Clear localhost cookies in Postman's Cookies manager before running. Expected result: 401 UNAUTHENTICATED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Authentication is required', () => pm.response.to.have.status(401));",
                  "pm.test('Correct error code', () => pm.expect(pm.response.json().error.code).to.eql('UNAUTHENTICATED'));"
                ]
              }
            }
          ]
