    {
      "name": "04 — Dashboard",
      "item": [
        {
          "name": "Overview",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/dashboard/overview?period=month",
            "description": "Returns real workspace/permission/notification context plus explicitly marked temporary populated Project/BOQ dashboard values."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Overview succeeds', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.test('Workspace scope and permissions exist', () => { pm.expect(data.scope.workspaceId).to.be.a('string'); pm.expect(data.permissions).to.be.an('object'); });",
                  "pm.test('Demo values are explicit', () => { pm.expect(data.dataSource).to.eql('hardcoded_demo'); pm.expect(data.demoData).to.eql(true); pm.expect(data.period).to.eql('month'); });",
                  "if (!data.permissions.canViewFinancials) pm.test('Financial values are hidden', () => pm.expect(data.kpis.totalEstimatedValue).to.eql(null));"
                ]
