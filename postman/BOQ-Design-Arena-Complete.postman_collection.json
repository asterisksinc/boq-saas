  "item": [
    {
      "name": "01 — Authentication",
      "description": "Supabase Auth is accessed only through the application API. Registration verification confirms the email; login verification populates Postman's cookie jar.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"displayName\": \"{{displayName}}\",\n  \"companyName\": \"{{companyName}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register",
            "description": "Creates the Supabase Auth user and atomically provisions the default workspace, owner membership, profile, preferences, workspace profile, onboarding progress, and audit event."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registered or duplicate is handled', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Registration OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/verify-email",
            "description": "Verifies the six-digit Gmail registration code and confirms the account. This does not create a login session."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Email verification succeeds', () => pm.response.to.have.status(200));",
                  "pm.test('Verified flag returned', () => pm.expect(pm.response.json().data.verified).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Request Login OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Sends a six-digit application-owned code through Gmail SMTP. Copy it into the otp environment variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('OTP request succeeds', () => pm.response.to.have.status(200));",
                  "pm.test('OTP sent flag returned', () => pm.expect(pm.response.json().data.otpSent).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Login OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Verifies the Gmail OTP and establishes the Supabase SSR cookie session."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('OTP verification succeeds', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Workspace context returned', () => pm.expect(json.data.context.workspace.id).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Session",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/refresh",
            "description": "Rotates/refreshes the cookie session. Requires a valid refresh cookie in Postman's cookie jar."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Session refreshed', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Auth Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/me",
            "description": "Returns authenticated identity, active workspace, membership, permissions, preferences, and onboarding."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Current context is authenticated', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.test('Permissions are server computed', () => pm.expect(data.permissions).to.have.property('canViewFinancials'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/logout",
            "description": "Revokes the local refresh session and clears the application session cookies. Idempotent for an already logged-out caller."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logout accepted', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/forgot-password",
            "description": "Always returns a generic response. Open the recovery email, copy the code query parameter from its redirect URL, and set resetCode in the environment."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Non-enumerating response', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{resetCode}}\",\n  \"password\": \"{{newPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/reset-password",
            "description": "Exchanges the one-time PKCE recovery code, changes the password, and signs out other sessions."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Password reset succeeds', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Resend Verification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/resend-verification",
            "description": "Returns a generic response and is rate limited."
          }
        }
      ]
    },
