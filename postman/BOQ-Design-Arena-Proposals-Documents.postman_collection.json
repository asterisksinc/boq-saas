{
  "info": {
    "name": "BOQ Design Arena — Proposals & Documents",
    "description": "Authenticated Phase 6 incremental API checks. Run an Auth collection first and keep Postman's cookie jar enabled. Apply the proposals/documents migration before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "proposalId", "value": "" },
    { "key": "folderId", "value": "" },
    { "key": "documentId", "value": "" },
    { "key": "sourceId", "value": "11111111-1111-4111-8111-111111111111" },
    { "key": "projectId", "value": "22222222-2222-4222-8222-222222222222" }
  ],
  "item": [
    {
      "name": "01 — Proposals",
      "item": [
        {
          "name": "Create Proposal — From Scratch",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"projectName\": \"Oberoi Residence - Bandra\",\n  \"clientName\": \"Nikhil Oberoi\",\n  \"sourceType\": \"scratch\",\n  \"proposedValue\": 5820000,\n  \"expiryDate\": \"2026-09-30\",\n  \"internalNotes\": \"Created from the proposal modal\",\n  \"scopeItems\": [\"Interior design and space planning\", \"Furniture procurement and installation\"]\n}" },
            "url": "{{baseUrl}}/api/v1/proposals"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Created', () => pm.response.to.have.status(201));", "const body = pm.response.json();", "if (body.data && body.data.id) pm.collectionVariables.set('proposalId', body.data.id);"] } }]
        },
        {
          "name": "Create Proposal — From BOQ",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"projectName\": \"Oberoi Residence - Bandra\",\n  \"clientName\": \"Nikhil Oberoi\",\n  \"sourceType\": \"boq\",\n  \"sourceId\": \"{{sourceId}}\",\n  \"sourceLabel\": \"Approved BOQ v7\",\n  \"proposedValue\": 5820000\n}" },
            "url": "{{baseUrl}}/api/v1/proposals"
          }
        },
        {
          "name": "Duplicate Existing Proposal",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"projectName\": \"Oberoi Residence - Bandra Copy\",\n  \"clientName\": \"Nikhil Oberoi\",\n  \"sourceType\": \"duplicate\",\n  \"sourceId\": \"{{proposalId}}\",\n  \"sourceLabel\": \"Existing proposal\",\n  \"proposedValue\": 5820000\n}" },
            "url": "{{baseUrl}}/api/v1/proposals"
          }
        },
        {
          "name": "List Proposals",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/proposals?page=1&pageSize=10&search=Oberoi" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Page returned', () => pm.response.to.have.status(200));", "pm.test('Stable page shape', () => pm.expect(pm.response.json().data.items).to.be.an('array'));"] } }]
        },
        { "name": "Proposal Summary", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/proposals/summary" } },
        { "name": "Get / Preview Proposal", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/proposals/{{proposalId}}" } },
        { "name": "Record Proposal View", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/proposals/{{proposalId}}/view" } },
        { "name": "Download Proposal PDF", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/proposals/{{proposalId}}/pdf" } },
        {
          "name": "Edit Proposal",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"proposedValue\": 6000000,\n  \"internalNotes\": \"Commercial value revised\"\n}" }, "url": "{{baseUrl}}/api/v1/proposals/{{proposalId}}" }
        },
        {
          "name": "Send Proposal",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"status\": \"sent\" }" }, "url": "{{baseUrl}}/api/v1/proposals/{{proposalId}}/status" }
        },
        {
          "name": "Mark Proposal Won",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"status\": \"won\" }" }, "url": "{{baseUrl}}/api/v1/proposals/{{proposalId}}/status" }
        },
        { "name": "Archive Proposal — Owner/Admin", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/proposals/{{proposalId}}" } }
      ]
    },
    {
      "name": "02 — Document Folders",
      "item": [
        {
          "name": "Create Folder",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"name\": \"Postman Projects\", \"parentId\": null }" }, "url": "{{baseUrl}}/api/v1/document-folders" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Folder created', () => pm.response.to.have.status(201));", "const body = pm.response.json();", "if (body.data && body.data.id) pm.collectionVariables.set('folderId', body.data.id);"] } }]
        },
        { "name": "List Root Folders", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/document-folders" } },
        { "name": "List Child Folders", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/document-folders?parentId={{folderId}}" } },
        { "name": "Rename Folder", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"name\": \"Postman Project Files\" }" }, "url": "{{baseUrl}}/api/v1/document-folders/{{folderId}}" } }
      ]
    },
    {
      "name": "03 — Documents",
      "item": [
        {
          "name": "Upload Document",
          "request": {
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [
              { "key": "folderId", "value": "{{folderId}}", "type": "text" },
              { "key": "projectId", "value": "{{projectId}}", "type": "text" },
              { "key": "projectName", "value": "Oberoi Residence - Bandra", "type": "text" },
              { "key": "file", "type": "file", "src": "" }
            ] },
            "url": "{{baseUrl}}/api/v1/documents/upload"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Uploaded', () => pm.response.to.have.status(201));", "const body = pm.response.json();", "if (body.data && body.data.id) pm.collectionVariables.set('documentId', body.data.id);"] } }]
        },
        { "name": "List Documents", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/documents?folderId={{folderId}}&page=1&pageSize=20" } },
        { "name": "Rename Document", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"name\": \"Oberoi Residence - Final.pdf\" }" }, "url": "{{baseUrl}}/api/v1/documents/{{documentId}}" } },
        { "name": "Get Signed Download URL", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/documents/{{documentId}}/download" } },
        { "name": "Delete Document — Owner/Admin", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/documents/{{documentId}}" } }
      ]
    },
    {
      "name": "04 — Negative Checks",
      "item": [
        {
          "name": "Reject Proposal Mass Assignment",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"projectName\": \"Test\", \"clientName\": \"Client\", \"proposedValue\": 1, \"workspaceId\": \"{{projectId}}\" }" }, "url": "{{baseUrl}}/api/v1/proposals" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Mass assignment rejected', () => pm.response.to.have.status(400));", "pm.test('Validation code', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'));"] } }]
        },
        {
          "name": "Reject Folder Delete Without Exact Name",
          "request": { "method": "DELETE", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"confirmation\": \"wrong-name\" }" }, "url": "{{baseUrl}}/api/v1/document-folders/{{folderId}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Confirmation rejected', () => pm.response.to.have.status(400));"] } }]
        },
        { "name": "Delete Folder — Owner/Admin (Run Last)", "request": { "method": "DELETE", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"confirmation\": \"Postman Project Files\" }" }, "url": "{{baseUrl}}/api/v1/document-folders/{{folderId}}" } }
      ]
    }
  ]
}
